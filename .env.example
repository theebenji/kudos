# Copy to .env for local development: cp .env.example .env
# Every app and script in the monorepo reads this one root file. Values below are dev-only defaults.

# --- Database (docker compose up -d) ---
DATABASE_URL=postgres://kudos:kudos@localhost:5432/kudos

# --- Auth bridge (ADR-0005): web signs short-lived JWTs, API verifies them. Must match in both apps. ---
AUTH_JWT_SECRET=dev-only-jwt-secret-change-me-at-least-32-chars

# --- Auth.js (apps/web) ---
# Generate a real one with: openssl rand -base64 32
AUTH_SECRET=dev-only-auth-secret-change-me-at-least-32-chars
# "Sign in as seeded user" picker. Defaults to on outside production; never enable for a real deployment.
AUTH_DEV_LOGIN=true
# Optional company SSO via any OIDC provider (Google, Microsoft Entra ID, Okta, …)
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_NAME=SSO

# --- API (apps/api) ---
API_PORT=4000
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:3000
# Optional: real GIF search. Without it the composer uses the bundled demo GIFs.
GIPHY_API_KEY=

# --- Web (apps/web) ---
API_URL=http://localhost:4000/graphql
# The API URL browsers use (differs from API_URL inside Docker).
PUBLIC_API_URL=http://localhost:4000/graphql

# --- Docs (pnpm docs:sync) — set this in .env.local instead, it's personal ---
# DOCS_VAULT_PATH=
